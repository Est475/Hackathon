import requests
import json
SOLDE_INSTANT = 1000

with open("exemple flux Hackathon.json", "r", encoding="utf-8") as fichier:
    donnees_flux = json.load(fichier)


#Données à remplacer par objet json [{date:..,heure:..,montant:..,société:..]
epargne = input("Quel montant souhaitez-vous mettre de coté ?")

#Lien à l'IA
CLE = "AQ.Ab8RN6LiDIIvSxIYiG5Ti9FD8Yk_BHZViq7pat7MN4uwxahZRA"
LIEN = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={CLE}"

PROMPT = f"""Tu es un algorithme de traitement financier.

Voici une liste de transactions brutes :
{donnees_flux}

RÈGLE ABSOLUE DE REGROUPEMENT (DÉDUPLICATION) :
Si plusieurs transactions concernent le MÊME marchand et un montant régulier (ex: un Loyer ou Netflix payé plusieurs fois), tu NE DOIS GÉNÉRER QU'UN SEUL objet JSON pour ce marchand.
Tu dois fusionner ces dépenses en ajoutant toutes leurs dates dans la liste "dates_apparition".

--- DÉBUT DE L'EXEMPLE DE LOGIQUE ---
INTERDIT (Ne jamais faire ça) :
[
  {{"marchand": "Propriétaire", "montant": -850, "dates_apparition": ["2026-08-01"]}},
  {{"marchand": "Propriétaire", "montant": -850, "dates_apparition": ["2026-09-01"]}}
]

OBLIGATOIRE (Ce que tu dois faire) :
[
  {{"marchand": "Propriétaire", "montant": -850, "dates_apparition": ["2026-08-01", "2026-09-01"]}}
]
--- FIN DE L'EXEMPLE ---

FORMAT DE SORTIE OBLIGATOIRE :
Tu dois répondre UNIQUEMENT par un tableau JSON valide. Ne génère aucun texte avant ou après.
[
  {{
    "categorie": "...",
    "marchand": "...",
    "montant": ...,
    "charge_fixe": true,
    "recette": false,
    "premiere_apparition": "...",
    "derniere_apparition": "...",
    "dates_apparition": ["...", "..."]
  }}
]
"""


try :
    donnees = {"contents": [{
        "parts": [{"text": PROMPT}]
    }]
    }
    reponse = requests.post(LIEN, json=donnees,headers={
        "Content-Type" : "application/json"}, timeout=10)
    reponse.raise_for_status()

    resultat_json = reponse.json()
    texte_IA = resultat_json["candidates"][0]["content"]["parts"][0]["text"]
    print("/nLe résultat est :")
    print(texte_IA)

except requests.exceptions.RequestException as e:
    print("Erreur de connexion à l'IA",e)

except KeyError:
    print("Erreur : Impossible d'extraire la réponse")
