    res3 = simuler_epargne(tx_f, _projection_depuis_moteur(tx_f, solde_f), solde_f, Objectif(2000, 12), gf)
    print(f"Capacité prudente : {eur(res3.capacite.capacite_prudente)}/mois | plans proposés : {len(res3.plans)}")
