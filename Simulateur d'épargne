def _projection_depuis_moteur(tx: pd.DataFrame, solde: float, horizon: int = 12) -> dict:
    """Produit la liste de projections (P10/P50/P90) avec le moteur du prototype."""
    from projection_bancaire import ajuster_modele, projeter, quantiles, tirer
    m = ajuster_modele(tx, solde)
    q = quantiles(projeter(m, tirer(m, horizon, 2000, seed=0)))
    return {"p10": q[0].round(0).tolist(), "p50": q[1].round(0).tolist(), "p90": q[2].round(0).tolist()}


def _afficher(res: ResultatEpargne, objectif: Objectif | None):
    c = res.capacite
    pd.set_option("display.width", 170)
    pd.set_option("display.max_colwidth", 110)
    print("=" * 96, "\na. CAPACITÉ D'ÉPARGNE\n", "=" * 96, sep="")
    print(f"Revenu mensuel moyen        : {eur(c.revenu_mensuel)}")
    print(f"Charges fixes               : {eur(c.charges_fixes)}   Dépenses variables : {eur(c.depenses_variables)}")
    print(f"Surplus structurel (moy.)   : {eur(c.surplus_structurel)}/mois (hors exceptionnels)")
    print(f"Surplus net : moyenne {eur(c.surplus_net_moyen)} | médiane {eur(c.surplus_net_median)} | "
          f"P10 {eur(c.surplus_net_p10)} | mois déficitaires {c.part_mois_deficitaires:.0%}")
    print(f"Surplus projeté (médiane)   : {eur(c.surplus_projete_median)}/mois")
    print(f"=> Capacité centrale        : {eur(c.capacite_centrale)}/mois (taux d'épargne actuel {c.taux_epargne_actuel:.0%})")
    print(f"=> Capacité prudente        : {eur(c.capacite_prudente)}/mois (le P10 du solde ne passe jamais sous son niveau actuel)")

    print("\n", "=" * 96, "\nb. COMPRESSIBILITÉ\n", "=" * 96, sep="")
    t = res.compressibilite.copy()
    t = t.assign(moyenne=t["moyenne"].round(0), part_depenses=(t["part_depenses"] * 100).round(0),
                 marge=t["marge"].round(0), cv=t["cv"].round(2))
    print(t[["classe", "moyenne", "part_depenses", "cv", "marge", "contrainte_limitante"]]
          .sort_values(["classe", "moyenne"], ascending=[True, False]).to_string())
    inc = res.compressibilite.query("classe == 'incompressible'")["moyenne"].sum()
    flex = res.compressibilite.query("classe != 'incompressible'")["moyenne"].sum()
    print(f"\nIncompressible : {eur(inc)}/mois | flexible et semi-flexible : {eur(flex)}/mois | "
          f"marge totale autorisée : {eur(res.compressibilite['marge'].sum())}/mois")

    print("\n", "=" * 96, "\nc. PLANS D'ACTION\n", "=" * 96, sep="")
    if objectif:
        print(f"Objectif : {objectif.libelle}, {eur(objectif.montant)}" +
              (f" en {objectif.horizon_mois} mois" if objectif.horizon_mois else ""))
    if res.plans:
        print(res.resume().to_string(index=False))
        print(f"\nPlan recommandé : {res.plan_recommande}")
        for p in res.plans:
            if p.actions:
                print(f"\n-> {p.nom} : {eur(p.economies_mensuelles)}/mois d'économies")
                for a in p.actions:
                    print(f"   • {a.description}")
                if p.contraintes_actives:
                    print("   Limites atteintes :", "; ".join(p.contraintes_actives))
    for a in res.avertissements:
        print(f"\n[!] {a}")
    if not res.plans:
        return

    ref = next(p for p in res.plans if p.nom == res.plan_recommande) if res.plan_recommande else res.plans[-1]
    print("\n", "=" * 96, f"\nd. PROJECTION IMPACTÉE (plan « {ref.nom} »)\n", "=" * 96, sep="")
    cols = ["mois", "solde_ref_p50", "solde_ajuste_p10", "solde_ajuste_p50", "solde_ajuste_p90", "versement",
            "epargne_cumulee", "patrimoine_p50"]
    print(ref.courbes[cols].iloc[[0, 2, 5, 8, 11]].round(0).to_string(index=False))

    print("\n", "=" * 96, f"\ne. GARDE-FOUS (plan « {ref.nom} »)\n", "=" * 96, sep="")
    for k in ref.controles:
        etat = {True: "OK ", False: "NON", None: "n/a"}[k.ok]
        print(f"[{etat}] {k.nom:<48} {k.valeur:<14} (seuil : {k.seuil})")


def main():
    from projection_bancaire import generer_historique
    tx = generer_historique()
    solde = 3500.0
    projection = _projection_depuis_moteur(tx, solde)
    objectif = Objectif(montant=6000, horizon_mois=12, libelle="Fonds pour un projet")
    gf = GardeFous(planchers_decents={"courses": 380})   # exemple : plancher décent sur les courses (à paramétrer)
    res = simuler_epargne(tx, projection, solde, objectif, gf)
    _afficher(res, objectif)

    print("\n\n", "#" * 96, "\nVARIANTE : projection fournie uniquement sous forme de liste (médiane)\n", "#" * 96, sep="")
    res2 = simuler_epargne(tx, projection["p50"], solde, Objectif(3000, 12), gf)
    print(res2.resume().to_string(index=False))
    print("[!]", res2.avertissements[0])

