#!/usr/bin/env python3
"""
Simulateur d'épargne : s'appuie sur les projections de solde et sur l'historique des flux.

    from simulateur_epargne import simuler_epargne, Objectif, GardeFous
    res = simuler_epargne(transactions, projection, solde_initial, objectif=Objectif(6000, 12))

Entrées
- transactions : DataFrame (date, libelle, montant signé, categorie) – tous les flux de l'utilisateur.
- projection   : une liste de soldes de fin de mois (médiane), OU un dict {"p10": [...], "p50": [...], "p90": [...]},
                 OU une matrice (n_simulations, horizon) issue du moteur Monte Carlo.
- solde_initial : solde actuel (point de départ de la projection).

Sorties (ResultatEpargne)
  a. capacite          : surplus mensuel (historique, projeté, prudent)
  b. compressibilite   : DataFrame par catégorie (incompressible / semi-flexible / flexible, marge en €/mois)
  c. plans             : plans d'action concrets, du moins au plus exigeant
  d. plan.courbes      : solde et épargne recalculés (P10/P50/P90) après application du plan
  e. plan.controles    : garde-fous éthiques vérifiés, contraintes actives, avertissements

Choix de conception
- Capacité PRUDENTE = plus petit surplus mensuel cumulé du P10 : min_t (P10_t - solde_initial) / t.
  Épargner ce montant ne fait jamais passer le P10 du solde sous son niveau actuel (on ne consomme pas le coussin).
- Plan : économies e (€/mois) obtenues par programme linéaire (minimiser la pénibilité pondérée), versement
  épargne = capacité prudente + économies réalisées. Le solde courant reste donc sécurisé par construction,
  et on le vérifie numériquement (garde-fou « liquidité »).
- Les garde-fous sont des PARAMÈTRES (GardeFous) : les valeurs par défaut sont génériques. Un budget décent réel
  dépend du pays et de la composition du ménage : à renseigner (budget_decent_mensuel, planchers_decents).
"""
from __future__ import annotations

import math
from dataclasses import dataclass, field

import numpy as np
import pandas as pd
from scipy.optimize import linprog

from projection_bancaire import (CAT_EXCEPTIONNELLES, CLASSE_CATEGORIE, PENIBILITE_CATEGORIE,
                                 detecter_recurrents, eur)

Z90 = 1.2816  # quantile 90 % de la loi normale

CLASSE_LOCALE = {"incompressible": "incompressible", "semi": "semi_flexible", "discretionnaire": "flexible"}
PENIBILITE_CLASSE = {"incompressible": 99.0, "semi_flexible": 3.0, "flexible": 1.0}


# --------------------------------------------------------------------------------------
# Paramètres et garde-fous éthiques
# --------------------------------------------------------------------------------------
@dataclass
class GardeFous:
    # Part maximale de réduction par classe de dépense (0 = intouchable)
    part_max_reduction: dict = field(default_factory=lambda: {"incompressible": 0.0, "semi_flexible": 0.15, "flexible": 0.50})
    # Le niveau de vie global (dépenses courantes) ne descend jamais sous cette part du niveau actuel
    niveau_vie_min_part: float = 0.90
    # Budget décent : dépenses courantes mensuelles minimales du ménage (€). None = non paramétré.
    budget_decent_mensuel: float | None = None
    # Planchers décents par catégorie (€/mois), ex. {"courses": 350}
    planchers_decents: dict = field(default_factory=dict)
    # Jamais de coupe sur ces catégories (en plus des dépenses incompressibles)
    categories_protegees: set = field(default_factory=lambda: {
        "sante", "education", "garde_enfants", "pension_alimentaire", "loyer", "assurances", "credit"})
    # On ne pousse pas l'épargne au-delà de cette part du revenu
    taux_epargne_max: float = 0.35
    # Au-dessus de cette part de charges fixes dans le revenu, ou si la capacité prudente est <= 0 : mode prudent
    seuil_fragilite_charges_fixes: float = 0.60
    # Catégories qui ne sont pas des flux de consommation (transferts internes, épargne existante)
    categories_exclues_flux: set = field(default_factory=lambda: {"epargne", "virement_interne"})
    # Forcer la classe d'une catégorie : {"voyages": "flexible"}
    classes_personnalisees: dict = field(default_factory=dict)


@dataclass
class Objectif:
    montant: float
    horizon_mois: int | None = None
    libelle: str = "Projet d'épargne"


# --------------------------------------------------------------------------------------
# Préparation des flux et de la projection
# --------------------------------------------------------------------------------------
def preparer_flux(transactions: pd.DataFrame, exclues: set) -> pd.DataFrame:
    """Étiquette chaque flux : revenu / charge_fixe (récurrents) / exceptionnel / variable."""
    tx = transactions.copy()
    tx["date"] = pd.to_datetime(tx["date"])
    tx = tx[~tx["categorie"].isin(exclues)].copy()
    tx["mois"] = tx["date"].dt.to_period("M")
    rec = tx["libelle"].isin(detecter_recurrents(tx))
    exc = ~rec & (tx["categorie"].isin(CAT_EXCEPTIONNELLES) | (tx["montant"] > 0))
    tx["nature"] = np.select([rec & (tx["montant"] > 0), rec & (tx["montant"] < 0), exc],
                             ["revenu", "charge_fixe", "exceptionnel"], default="variable")
    return tx


def table_mensuelle(tx: pd.DataFrame, mois_hist: pd.PeriodIndex) -> pd.DataFrame:
    p = tx.pivot_table(index="mois", columns="nature", values="montant", aggfunc="sum")
    p = p.reindex(index=mois_hist, columns=["revenu", "charge_fixe", "variable", "exceptionnel"]).fillna(0.0)
    out = pd.DataFrame({"revenus": p["revenu"], "charges_fixes": -p["charge_fixe"],
                        "variables": -p["variable"], "exceptionnels_net": p["exceptionnel"]})
    out["surplus_structurel"] = out["revenus"] - out["charges_fixes"] - out["variables"]
    out["surplus_net"] = out["surplus_structurel"] + out["exceptionnels_net"]
    return out


@dataclass
class ProjectionSolde:
    p10: np.ndarray
    p50: np.ndarray
    p90: np.ndarray
    approximative: bool        # True si P10/P90 reconstruits faute de quantiles fournis
    premier_mois: pd.Period

    @property
    def horizon(self) -> int:
        return len(self.p50)


def normaliser_projection(projection, premier_mois: pd.Period, sigma_mensuel: float) -> ProjectionSolde:
    if isinstance(projection, dict):
        q = {k: np.asarray(v, float) for k, v in projection.items()}
    else:
        a = np.asarray(projection, float)
        q = ({"p10": np.quantile(a, 0.1, axis=0), "p50": np.quantile(a, 0.5, axis=0), "p90": np.quantile(a, 0.9, axis=0)}
             if a.ndim == 2 else {"p50": a})
    if "p50" not in q:
        raise ValueError("La projection doit contenir au minimum la médiane (p50).")
    t = np.arange(1, len(q["p50"]) + 1)
    approx = not {"p10", "p90"} <= q.keys()
    q.setdefault("p10", q["p50"] - Z90 * sigma_mensuel * np.sqrt(t))
    q.setdefault("p90", q["p50"] + Z90 * sigma_mensuel * np.sqrt(t))
    return ProjectionSolde(q["p10"], q["p50"], q["p90"], approx, premier_mois)


# --------------------------------------------------------------------------------------
# a. Capacité d'épargne
# --------------------------------------------------------------------------------------
@dataclass
class CapaciteEpargne:
    revenu_mensuel: float
    charges_fixes: float
    depenses_variables: float
    surplus_structurel: float       # R - charges fixes - variables (hors exceptionnels), moyenne historique
    surplus_net_moyen: float        # y compris exceptionnels
    surplus_net_median: float
    surplus_net_p10: float
    part_mois_deficitaires: float
    surplus_projete_median: float   # médiane des variations mensuelles de la projection P50
    capacite_centrale: float        # min(médiane historique, médiane projetée), plancher 0
    capacite_prudente: float        # min_t (P10_t - solde_initial) / t  (peut être négative)
    taux_epargne_actuel: float      # surplus net moyen / revenu
    projection_approximative: bool
    historique: pd.DataFrame


def calculer_capacite(hist: pd.DataFrame, proj: ProjectionSolde, solde_initial: float) -> CapaciteEpargne:
    t = np.arange(1, proj.horizon + 1)
    surplus_proj = np.diff(np.r_[solde_initial, proj.p50])
    revenu = float(hist["revenus"].mean())
    net = hist["surplus_net"]
    return CapaciteEpargne(
        revenu_mensuel=revenu, charges_fixes=float(hist["charges_fixes"].mean()),
        depenses_variables=float(hist["variables"].mean()),
        surplus_structurel=float(hist["surplus_structurel"].mean()),
        surplus_net_moyen=float(net.mean()), surplus_net_median=float(net.median()),
        surplus_net_p10=float(net.quantile(0.10)), part_mois_deficitaires=float((net < 0).mean()),
        surplus_projete_median=float(np.median(surplus_proj)),
        capacite_centrale=max(0.0, min(float(net.median()), float(np.median(surplus_proj)))),
        capacite_prudente=float(np.min((proj.p10 - solde_initial) / t)),
        taux_epargne_actuel=float(net.mean() / revenu) if revenu > 0 else 0.0,
        projection_approximative=proj.approximative, historique=hist)


# --------------------------------------------------------------------------------------
# b. Compressibilité
# --------------------------------------------------------------------------------------
def classe_categorie(cat: str, gf: GardeFous) -> str:
    if cat in gf.classes_personnalisees:
        return gf.classes_personnalisees[cat]
    c = CLASSE_LOCALE[CLASSE_CATEGORIE.get(cat, "semi")]
    return "incompressible" if cat in gf.categories_protegees else c


def analyser_compressibilite(tx: pd.DataFrame, mois_hist: pd.PeriodIndex, gf: GardeFous, mode_prudent: bool):
    """Retourne (DataFrame par catégorie, postes récurrents par catégorie)."""
    dep = tx[tx["nature"].isin(["charge_fixe", "variable"])]
    cats = sorted(dep["categorie"].unique())
    n = len(mois_hist)
    tot = (-dep.pivot_table(index="mois", columns="categorie", values="montant", aggfunc="sum")
           ).reindex(index=mois_hist, columns=cats).fillna(0.0)

    fixes = (dep[dep["nature"] == "charge_fixe"].groupby("libelle")
             .agg(m=("montant", lambda s: -s.median()), c=("categorie", "first")))
    fixe_cat = fixes.groupby("c")["m"].sum()
    postes = {c: [(lib, float(r["m"])) for lib, r in fixes[fixes["c"] == c].iterrows()] for c in cats}

    var = dep[dep["nature"] == "variable"]
    ticket = (-var.groupby("categorie")["montant"].mean()).to_dict()
    nb_tx = (var.groupby("categorie").size() / n).to_dict()

    total = float(tot.mean().sum())
    lignes = []
    for c in cats:
        moy, cl = float(tot[c].mean()), classe_categorie(c, gf)
        p10 = float(tot[c].quantile(0.10))
        part_rec = float(fixe_cat.get(c, 0.0) / moy) if moy > 0 else 0.0
        b_classe = gf.part_max_reduction[cl] * moy
        b_hist = max(0.0, moy - p10) if part_rec < 0.9 else b_classe   # poste non récurrent : on reste au-dessus du P10 vécu
        b_decent = max(0.0, moy - gf.planchers_decents[c]) if c in gf.planchers_decents else math.inf
        bornes = {"part max de la classe": b_classe, "plancher historique (P10)": b_hist, "plancher décent": b_decent}
        limite = min(bornes, key=bornes.get)
        marge = bornes[limite]
        if mode_prudent and cl == "semi_flexible":
            marge, limite = 0.0, "mode prudent (dépenses essentielles)"
        if cl == "incompressible":
            limite = "incompressible ou protégée"
        lignes.append({
            "categorie": c, "classe": cl, "moyenne": moy, "part_depenses": moy / total,
            "cv": float(tot[c].std(ddof=0) / moy) if moy > 0 else 0.0, "plancher_p10": p10,
            "part_recurrente": part_rec, "marge": float(marge), "contrainte_limitante": limite,
            "ticket_moyen": float(ticket.get(c, np.nan)), "nb_tx_mois": float(nb_tx.get(c, 0.0)),
            "penibilite": PENIBILITE_CATEGORIE.get(c, PENIBILITE_CLASSE[cl])})
    return pd.DataFrame(lignes).set_index("categorie"), postes


