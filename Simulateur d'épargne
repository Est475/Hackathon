@dataclass
class Action:
    categorie: str
    type: str              # resilier | renegocier | reduire_frequence | plafonner_budget
    montant_mensuel: float
    description: str


@dataclass
class Controle:
    nom: str
    ok: bool | None        # None = non évaluable (paramètre non renseigné)
    valeur: str
    seuil: str
    message: str


@dataclass
class PlanEpargne:
    nom: str
    economies_mensuelles: float
    versement_mensuel: float
    taux_epargne: float
    baisse_niveau_vie_pct: float
    effort: float
    actions: list[Action]
    reductions: dict[str, float]
    contraintes_actives: list[str]
    courbes: pd.DataFrame
    controles: list[Controle]
    epargne_fin_horizon: float
    mois_objectif: int | None = None
    atteint_dans_horizon: bool | None = None

    @property
    def garde_fous_ok(self) -> bool:
        return all(c.ok is not False for c in self.controles)


def allouer_reductions(comp: pd.DataFrame, e: float) -> np.ndarray:
    """Programme linéaire : minimiser la pénibilité pondérée sous la contrainte d'économies = e."""
    marge = comp["marge"].values
    if e <= 0.5:
        return np.zeros(len(marge))
    res = linprog(c=comp["penibilite"].values, A_eq=np.ones((1, len(marge))), b_eq=[e],
                  bounds=[(0, b) for b in marge], method="highs")
    return res.x if res.status == 0 else marge * min(1.0, e / marge.sum())


def generer_actions(comp: pd.DataFrame, x: np.ndarray, postes: dict) -> list[Action]:
    actions = []
    for (cat, row), montant in zip(comp.iterrows(), x):
        if montant < 1.0:
            continue
        cl = row["classe"]
        if row["part_recurrente"] >= 0.9:                      # poste contractuel : résilier ou renégocier
            restant, choisis = montant, []
            for lib, m in sorted(postes[cat], key=lambda p: -p[1]):
                if cl == "flexible" and m <= restant + 0.5:
                    choisis.append((lib, m))
                    restant -= m
            if choisis:
                liste = ", ".join(f"{lib} ({m:.2f} €/mois)" for lib, m in choisis)
                txt = f"Résilier : {liste}"
                txt += f", puis renégocier ≈ {restant:.0f} €/mois" if restant >= 2 else ""
                actions.append(Action(cat, "resilier", montant, txt))
            else:
                lib = max(postes[cat], key=lambda p: p[1])[0]
                actions.append(Action(cat, "renegocier", montant,
                                      f"Renégocier ou comparer l'offre « {lib} » pour économiser ≈ {montant:.0f} €/mois"))
        elif cl == "flexible":
            nb, tk = row["nb_tx_mois"], row["ticket_moyen"]
            moins = montant / tk if tk > 0 else 0.0
            actions.append(Action(cat, "reduire_frequence", montant,
                                  f"{cat} : passer de {nb:.1f} à {max(0.0, nb - moins):.1f} achats par mois "
                                  f"(panier moyen {tk:.0f} €), soit −{montant:.0f} €/mois"))
        else:
            nouveau = row["moyenne"] - montant
            actions.append(Action(cat, "plafonner_budget", montant,
                                  f"Plafonner le budget {cat} à {nouveau:.0f} €/mois (au lieu de {row['moyenne']:.0f} €), "
                                  f"soit ≈ {nouveau / 4.33:.0f} €/semaine"))
    return sorted(actions, key=lambda a: -a.montant_mensuel)


# --------------------------------------------------------------------------------------
# d. Projection impactée
# --------------------------------------------------------------------------------------
def projeter_impact(proj: ProjectionSolde, solde_initial: float, e: float, v0: float,
                    montee_en_charge: int, rendement_annuel: float) -> pd.DataFrame:
    """Recalcule solde courant (P10/P50/P90) et épargne. Économies progressives ; versement = v0 + économies."""
    h = proj.horizon
    t = np.arange(1, h + 1)
    rampe = np.minimum(1.0, t / montee_en_charge) if montee_en_charge > 0 else np.ones(h)
    eco = e * rampe
    vers = np.maximum(0.0, v0 + eco)
    eco_cum, vers_cum = np.cumsum(eco), np.cumsum(vers)
    epargne, stock = np.zeros(h), 0.0
    for i in range(h):
        stock = stock * (1 + rendement_annuel / 12) + vers[i]
        epargne[i] = stock
    d = pd.DataFrame({
        "mois": pd.period_range(proj.premier_mois, periods=h, freq="M").strftime("%Y-%m"),
        "solde_ref_p10": proj.p10, "solde_ref_p50": proj.p50, "solde_ref_p90": proj.p90,
        "economies": eco, "versement": vers, "epargne_cumulee": epargne,
        "solde_ajuste_p10": proj.p10 + eco_cum - vers_cum,
        "solde_ajuste_p50": proj.p50 + eco_cum - vers_cum,
        "solde_ajuste_p90": proj.p90 + eco_cum - vers_cum})
    d["patrimoine_p50"] = d["solde_ajuste_p50"] + d["epargne_cumulee"]
    return d


# --------------------------------------------------------------------------------------
# e. Garde-fous éthiques
# --------------------------------------------------------------------------------------
def verifier_garde_fous(comp: pd.DataFrame, x: np.ndarray, courbes: pd.DataFrame, cap: CapaciteEpargne,
                        gf: GardeFous, plancher_liquidite: float, total: float) -> list[Controle]:
    cc = []
    intouchables = [c for c, r in comp.iterrows() if r["classe"] == "incompressible"]
    touche = [c for c in intouchables if x[comp.index.get_loc(c)] > 1e-6]
    cc.append(Controle("Dépenses incompressibles et protégées intactes", not touche,
                       "aucune coupe" if not touche else ", ".join(touche), "0 €",
                       "Loyer, assurances, crédit, santé... ne sont jamais réduits."))

    ratio = 1 - x.sum() / total
    cc.append(Controle("Niveau de vie conservé", ratio >= gf.niveau_vie_min_part - 1e-9, f"{ratio:.1%}",
                       f"≥ {gf.niveau_vie_min_part:.0%}", "Part des dépenses courantes actuelles maintenue."))

    if gf.budget_decent_mensuel is None:
        cc.append(Controle("Budget décent", None, "—", "non paramétré",
                           "Renseigner budget_decent_mensuel (budget de référence du pays et du ménage)."))
    else:
        reste = total - x.sum()
        cc.append(Controle("Budget décent", reste >= gf.budget_decent_mensuel, eur(reste),
                           f"≥ {eur(gf.budget_decent_mensuel)}", "Dépenses courantes après plan."))

    viol = []
    for (c, r), xi in zip(comp.iterrows(), x):
        nouveau = r["moyenne"] - xi
        if c in gf.planchers_decents and nouveau < gf.planchers_decents[c] - 0.5:
            viol.append(c)
        if r["part_recurrente"] < 0.9 and r["classe"] != "incompressible" and nouveau < r["plancher_p10"] - 0.5:
            viol.append(c)
    cc.append(Controle("Planchers par catégorie respectés", not viol, "ok" if not viol else ", ".join(set(viol)),
                       "P10 vécu et planchers décents", "Jamais sous le niveau déjà atteint par l'utilisateur."))

    taux = float(courbes["versement"].iloc[-1]) / cap.revenu_mensuel if cap.revenu_mensuel > 0 else 0.0
    cc.append(Controle("Taux d'épargne raisonnable", taux <= gf.taux_epargne_max + 1e-9, f"{taux:.1%}",
                       f"≤ {gf.taux_epargne_max:.0%}", "On ne pousse pas l'épargne au détriment du quotidien."))

    mini = float(courbes["solde_ajuste_p10"].min())
    cc.append(Controle("Liquidité préservée (P10 du solde courant)", mini >= plancher_liquidite - 0.5,
                       eur(mini), f"≥ {eur(plancher_liquidite)}", "Le solde courant reste sécurisé dans 9 cas sur 10."))
    return cc


# --------------------------------------------------------------------------------------
# Orchestration
# --------------------------------------------------------------------------------------
@dataclass
class ResultatEpargne:
    capacite: CapaciteEpargne
    compressibilite: pd.DataFrame
    plans: list[PlanEpargne]
    plan_recommande: str | None
    avertissements: list[str]
    mode_prudent: bool

    def resume(self) -> pd.DataFrame:
        return pd.DataFrame([{
            "Plan": p.nom, "Économies (€/mois)": round(p.economies_mensuelles),
            "Versement épargne (€/mois)": round(p.versement_mensuel),
            "Taux d'épargne": f"{p.taux_epargne:.0%}", "Baisse du niveau de vie": f"{p.baisse_niveau_vie_pct:.1%}",
            "Épargne en fin d'horizon": round(p.epargne_fin_horizon),
            "Mois pour l'objectif": p.mois_objectif if p.mois_objectif is not None else "—",
            "Garde-fous": "ok" if p.garde_fous_ok else "violés"} for p in self.plans])


def _mois_pour_objectif(courbes: pd.DataFrame, montant: float) -> int | None:
    ep = courbes["epargne_cumulee"].values
    atteint = np.where(ep >= montant)[0]
    if len(atteint):
        return int(atteint[0]) + 1
    dernier = float(courbes["versement"].iloc[-1])
    return len(ep) + math.ceil((montant - ep[-1]) / dernier) if dernier > 0 else None


def simuler_epargne(transactions: pd.DataFrame, projection, solde_initial: float,
                    objectif: Objectif | None = None, garde_fous: GardeFous | None = None,
                    rendement_annuel: float = 0.0, montee_en_charge_mois: int = 2) -> ResultatEpargne:
    gf = garde_fous or GardeFous()
    tx = preparer_flux(transactions, gf.categories_exclues_flux)
    mois_hist = pd.period_range(tx["mois"].min(), tx["mois"].max(), freq="M")
    hist = table_mensuelle(tx, mois_hist)

    proj = normaliser_projection(projection, mois_hist[-1] + 1, float(hist["surplus_net"].std(ddof=0)))
    cap = calculer_capacite(hist, proj, solde_initial)

    avert = []
    if proj.approximative:
        avert.append("Quantiles P10/P90 absents : reconstruits à partir de la dispersion historique du surplus.")
    ratio_fixes = cap.charges_fixes / cap.revenu_mensuel if cap.revenu_mensuel > 0 else 1.0
    prudent = ratio_fixes > gf.seuil_fragilite_charges_fixes or cap.capacite_prudente <= 0
    if prudent:
        avert.append(f"Situation fragile (charges fixes = {ratio_fixes:.0%} du revenu, capacité prudente "
                     f"{eur(cap.capacite_prudente)}/mois) : aucune coupe sur les dépenses essentielles. "
                     "Un accompagnement humain (conseil budgétaire) est recommandé avant tout plan d'épargne.")
    if solde_initial < float(hist["charges_fixes"].mean()):
        avert.append("Le solde actuel est inférieur à un mois de charges fixes : reconstituer ce coussin est prioritaire.")

    comp, postes = analyser_compressibilite(tx, mois_hist, gf, prudent)
    total = float(comp["moyenne"].sum())

    # Plafond global d'économies : niveau de vie, budget décent, taux d'épargne max
    plafond = (1 - gf.niveau_vie_min_part) * total
    if gf.budget_decent_mensuel is not None:
        plafond = min(plafond, total - gf.budget_decent_mensuel)
    v0 = cap.capacite_prudente
    e_min = max(0.0, -v0)
    e_max = max(0.0, min(float(comp["marge"].sum()), plafond, gf.taux_epargne_max * cap.revenu_mensuel - v0))

    plans: list[PlanEpargne] = []
    if e_max + 0.5 < e_min:
        avert.append(f"Même avec les ajustements autorisés par les garde-fous (≤ {eur(e_max)}/mois), le budget "
                     f"n'est pas équilibré (il manque {eur(e_min - e_max)}/mois) : aucun plan d'épargne proposé. "
                     "Les garde-fous empêchent de sacrifier le niveau de vie décent pour y parvenir.")
    else:
        niveaux = sorted({round(e_min + f * (e_max - e_min), 1) for f in (0, 1 / 3, 2 / 3, 1)})
        noms = (["Sans ajustement" if e_min == 0 else "Retour à l'équilibre", "Léger", "Équilibré", "Ambitieux"]
                if len(niveaux) == 4 else
                (["Sans ajustement" if e_min == 0 else "Retour à l'équilibre"] + ["Ajusté", "Ambitieux"])[:len(niveaux)])
        plancher_liq = min(solde_initial, solde_initial)  # on ne descend jamais sous le solde actuel (flux seulement)
        for nom, e in zip(noms, niveaux):
            x = allouer_reductions(comp, e)
            courbes = projeter_impact(proj, solde_initial, e, v0, montee_en_charge_mois, rendement_annuel)
            vers = float(courbes["versement"].iloc[-1])
            limites = [f"{c} : {r['contrainte_limitante']}" for (c, r), xi in zip(comp.iterrows(), x)
                       if r["marge"] > 0 and xi >= r["marge"] - 0.5]
            if e >= e_max - 0.5 and e_max > 0 and e_max >= plafond - 0.5:
                limites.append("plafond global de réduction du niveau de vie")
            if e >= e_max - 0.5 and e_max > 0 and e_max >= gf.taux_epargne_max * cap.revenu_mensuel - v0 - 0.5:
                limites.append("taux d'épargne maximal")
            plan = PlanEpargne(
                nom=nom, economies_mensuelles=float(x.sum()), versement_mensuel=vers,
                taux_epargne=vers / cap.revenu_mensuel if cap.revenu_mensuel > 0 else 0.0,
                baisse_niveau_vie_pct=float(x.sum() / total), effort=float(comp["penibilite"].values @ x),
                actions=generer_actions(comp, x, postes),
                reductions={c: round(float(v), 1) for c, v in zip(comp.index, x) if v > 0.5},
                contraintes_actives=limites, courbes=courbes,
                controles=verifier_garde_fous(comp, x, courbes, cap, gf, plancher_liq, total),
                epargne_fin_horizon=float(courbes["epargne_cumulee"].iloc[-1]))
            if objectif:
                plan.mois_objectif = _mois_pour_objectif(courbes, objectif.montant)
                if objectif.horizon_mois:
                    plan.atteint_dans_horizon = plan.mois_objectif is not None and plan.mois_objectif <= objectif.horizon_mois
            plans.append(plan)

    recommande = None
    if plans:
        if objectif and objectif.horizon_mois:
            ok = [p for p in plans if p.atteint_dans_horizon and p.garde_fous_ok]
            recommande = ok[0].nom if ok else None
            if not ok:
                avert.append(f"Objectif de {eur(objectif.montant)} en {objectif.horizon_mois} mois hors d'atteinte sans "
                             f"dépasser les garde-fous. Voir « Mois pour l'objectif » : allonger l'horizon est la voie "
                             "la moins coûteuse pour le niveau de vie.")
        else:
            recommande = next((p.nom for p in plans if p.nom == "Équilibré"), plans[0].nom)
    return ResultatEpargne(cap, comp, plans, recommande, avert, prudent)


